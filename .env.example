# Copy values to your server environment. Never commit credentials.
GITHUB_RANK_DB=data/github_rank.sqlite3
GITHUB_RANK_CONFIG=config/sources.yaml
# Optional; public collection works at a smaller rate without this.
GITHUB_TOKEN=

# Optional existing Ollama service. Blank model disables generation.
GITHUB_RANK_SUMMARY_MODEL=
GITHUB_RANK_SUMMARY_URL=http://127.0.0.1:11434
GITHUB_RANK_SUMMARY_DAILY_LIMIT=20
# Set true explicitly to allow scheduler generation. Manual summarize remains available.
GITHUB_RANK_AUTO_SUMMARY=false
